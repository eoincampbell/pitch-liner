@page
@model IndexModel
@{
    ViewData["Title"] = "Map Distance";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Map Distance</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="https://atlas.microsoft.com/sdk/javascript/mapcontrol/3/atlas.min.css" />
    <link rel="stylesheet" href="~/css/map-distance.css" asp-append-version="true" />
    <script src="https://atlas.microsoft.com/sdk/javascript/mapcontrol/3/atlas.min.js"></script>
</head>
<body>
    <div id="map"></div>

    <!-- Stats panel -->
    <div id="stats-panel">
        <div id="panel-content">
            <div id="panel-scroll">
                <div id="stats-body"></div>
                <div id="area-info"></div>
                <div id="overall-total" class="overall-total" style="display:none;"></div>
            </div>

            <div id="panel-controls">
                <hr class="panel-divider" />

                <!-- Drawing group -->
                <div class="btn-group">
                    <span class="btn-group-label">Drawing</span>
                    <div class="btn-row">
                        <button class="btn btn-dark" onclick="newPath()" title="Start a new path">&#x2795; Path</button>
                        <button class="btn btn-warning" onclick="undoLastPin()" title="Remove last pin">&#x21A9; Undo</button>
                        <button class="btn btn-secondary" onclick="closeShape()" title="Enclose shape and calculate area">&#x25B3; Enclose</button>
                    </div>
                </div>

                <!-- Data group -->
                <div class="btn-group">
                    <span class="btn-group-label">Data</span>
                    <div class="btn-row">
                        <button class="btn btn-success" onclick="saveCsv()" title="Download CSV">&#x1F4BE; Save</button>
                        <button class="btn btn-primary" onclick="document.getElementById('load-input').click()" title="Load CSV file">&#x1F4C2; Load</button>
                        <button class="btn btn-purple" onclick="shareUrl()" title="Copy share URL to clipboard">&#x1F517; Share</button>
                        <input type="file" id="load-input" accept=".csv" style="display:none" onchange="loadCsv(event)" />
                    </div>
                </div>

                <!-- Actions group -->
                <div class="btn-group">
                    <div class="btn-row">
                        <button class="btn btn-danger" onclick="openClearConfirm()" title="Remove all paths and pins (asks for confirmation)">&#x1F9FD; Clear All</button>
                        <button class="btn btn-info" onclick="showHelp()" title="Show help">? Help</button>
                        <button class="btn btn-pink" onclick="startTour(true)" title="Take the tour again">&#x1F9ED; Tour</button>
                    </div>
                </div>

                <hr class="panel-divider" />

                <!-- Options -->
                <div class="panel-options-row">
                    <label class="option-select" title="Pin label mode">
                        <span class="option-text">Labels</span>
                        <select id="label-mode-select" onchange="changeLabelMode()">
                            <option value="off" selected>Off</option>
                            <option value="individual">Single Dist.</option>
                            <option value="cumulative">Cumul. Dist</option>
                        </select>
                    </label>
                    <label class="option-select" title="Distance unit">
                        <span class="option-text">Unit</span>
                        <select id="unit-select" onchange="changeUnit()">
                            <option value="m">m</option>
                            <option value="yd">yd</option>
                            <option value="km">km</option>
                            <option value="mi">mi</option>
                        </select>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <!-- Slide toggle tab -->
    <button id="panel-toggle" class="panel-toggle" onclick="togglePanel()" title="Toggle stats panel">&#x25C0;</button>

    <!-- Branding -->
    <div id="branding">
        <img src="https://whitehallcolmcille.ie/wp-content/uploads/2019/06/logo.png" alt="Whitehall Colmcille GAA" />
        <span>Whitehall Colmcille GAA</span>
    </div>

    <!-- Search bar -->
    <div id="search-bar">
        <div class="search-row">
            <select id="location-select" title="Switch pitch location" aria-label="Pitch location"></select>
            <input type="text" id="search-input" placeholder="Search for an address..." autocomplete="off" />
        </div>
        <div id="search-results"></div>
    </div>

    <!-- Map controls -->
    <div id="map-controls">
        <button class="map-ctrl-btn" onclick="mapZoom(1)" title="Zoom in">+</button>
        <button class="map-ctrl-btn" onclick="mapZoom(-1)" title="Zoom out">−</button>
        <button class="map-ctrl-btn" onclick="resetView()" title="Reset view">⌂</button>
        <button class="map-ctrl-btn" onclick="toggleStyle()" title="Toggle map style">🗺</button>

        <!-- Debug overlay: append ?debug=1 to the URL to display live camera info
             (centre latitude/longitude, zoom, bearing and pitch).
             It is a view-only aid and is never included in saved CSVs or shared links. -->
        <div id="debug-box" style="display:none">
            <div class="debug-row"><span class="debug-label">Lat</span><span id="debug-lat">-</span></div>
            <div class="debug-row"><span class="debug-label">Lng</span><span id="debug-lng">-</span></div>
            <div class="debug-row"><span class="debug-label">Zoom</span><span id="debug-zoom">-</span></div>
            <div class="debug-row"><span class="debug-label">Bearing</span><span id="debug-bearing">-</span></div>
            <div class="debug-row"><span class="debug-label">Pitch</span><span id="debug-pitch">-</span></div>
        </div>
    </div>

    <!-- Elevation panel -->
    <div id="elevation-panel">
        <h4>Elevation Profile</h4>
        <canvas id="elevation-canvas" width="340" height="120"></canvas>
    </div>

    <!-- Help modal -->
    <div class="modal-overlay" id="help-modal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeHelp()">&times;</button>
            <h2>Pitch Liner – Map Distance Tool</h2>
            <h4>Keyboard Shortcuts</h4>
            <table class="shortcut-table">
                <tbody>
                    <tr><td><kbd>Shift</kbd> + <kbd>?</kbd></td><td>Open this help window.</td></tr>
                    <tr><td><kbd>Esc</kbd></td><td>Close any open window.</td></tr>
                    <tr><td><kbd>a</kbd></td><td>Add a new path.</td></tr>
                    <tr><td><kbd>z</kbd></td><td>Undo the last action.</td></tr>
                    <tr><td><kbd>e</kbd></td><td>Enclose the current active path.</td></tr>
                    <tr><td><kbd>c</kbd></td><td>Clear all paths (asks for confirmation first).</td></tr>
                </tbody>
            </table>
            <p class="shortcut-note">A brief on-screen message confirms each action. Shortcuts are ignored while you are typing in the search bar or renaming a path.</p>
            <h4>Placing Pins</h4>
            <ul>
                <li>Click anywhere on the map to drop a pin on the active path.</li>
                <li>Pins are connected by dotted lines; distances appear in the stats panel.</li>
                <li>Click and hold any existing pin &ndash; in any path, active or not &ndash; to drag it to a new position. Lines, distances and areas update automatically, and that path becomes the active one.</li>
            </ul>
            <h4>Multiple Paths</h4>
            <ul>
                <li><strong>&#x2795; Path</strong> – Create a new path with a unique colour (shortcut <kbd>a</kbd>).</li>
                <li>Click a path name in the panel to rename it.</li>
                <li>Click the coloured dot beside a path name to open the colour picker and choose a different colour from the palette. Lines, pins, the shape fill and its label all change immediately.</li>
                <li>Use the <em>Set Active</em> button to switch between paths – new pins are always added to the active path.</li>
            </ul>
            <h4>Drawing Controls</h4>
            <ul>
                <li><strong>&#x21A9; Undo</strong> – Remove the last pin on the active path (shortcut <kbd>z</kbd>).</li>
                <li><strong>&#x25B3; Enclose Path</strong> – Connect last pin to first, creating a closed shape with an area calculation (requires 3+ pins; shortcut <kbd>e</kbd>).</li>
                <li><strong>&#x1F9FD; Clear All</strong> – Remove every path and pin. You will be asked to confirm first (shortcut <kbd>c</kbd>).</li>
            </ul>
            <h4>Data Controls</h4>
            <ul>
                <li><strong>&#x1F4BE; Save</strong> – Download all path data (including closed state) as a CSV file.</li>
                <li><strong>&#x1F4C2; Load</strong> – Upload a previously saved CSV to restore paths, closed shapes, and map position.</li>
                <li><strong>&#x1F517; Share</strong> – Copy a URL to the clipboard that encodes all paths, closed shapes, and the current map view (position, zoom, tilt, rotation).</li>
            </ul>
            <h4>Options</h4>
            <ul>
                <li><strong>Pin Labels</strong> – Toggle to show/hide numbered labels and running distances on the map.</li>
                <li><strong>Unit</strong> – Switch between metres (m), yards (yd), kilometres (km), and miles (mi). Affects all distances and areas.</li>
            </ul>
            <h4>Map Controls</h4>
            <ul>
                <li><strong>+</strong> / <strong>−</strong> – Zoom in or out.</li>
                <li><strong>⌂</strong> – Reset to default view.</li>
                <li><strong>🗺</strong> – Toggle between satellite and road map view.</li>
                <li>Right-click + drag to rotate and tilt the map (bearing &amp; pitch are saved in Share links).</li>
            </ul>
            <h4>Locations</h4>
            <ul>
                <li>Use the dropdown beside the search bar to switch between club pitch locations.</li>
                <li>The map opens on <strong>Ellenfield Park</strong> by default.</li>
                <li>If pins or paths are on the map, you'll be asked to confirm before switching &ndash; confirming clears the map and recentres on the new location.</li>
                <li>The selected location is included in Share links and saved CSV files, along with your exact map view.</li>
            </ul>
            <h4>Search</h4>
            <ul>
                <li>Type in the search bar to find addresses, landmarks, sports grounds, and points of interest.</li>
                <li>Click a result to centre the map on that location.</li>
            </ul>
            <h4>Mouse &amp; Touch</h4>
            <ul>
                <li>Scroll wheel to zoom; pinch to zoom on touch devices.</li>
                <li>Two-finger rotate on touch; Ctrl + drag to rotate on desktop.</li>
                <li>On touch devices, press and hold a pin for a moment before dragging it &ndash; a quick swipe still pans the map.</li>
            </ul>
            <h4>Getting Started</h4>
            <ul>
                <li>New here? Click <strong>&#x1F9ED; Tour</strong> any time to replay the guided walkthrough of the core features.</li>
            </ul>
            <h4>About</h4>
            <ul>
                <li>Pitch Liner is open source &ndash; browse the <a href="https://github.com/eoincampbell/pitch-liner" target="_blank" rel="noopener">source on GitHub</a>, or report a bug or suggest a feature on the <a href="https://github.com/eoincampbell/pitch-liner/issues" target="_blank" rel="noopener">issue tracker</a>.</li>
            </ul>
        </div>
    </div>

    <!-- Location switch confirmation modal -->
    <div class="modal-overlay" id="location-confirm-modal">
        <div class="modal-content modal-sm">
            <h2>Switch Location?</h2>
            <p>Switching location will clear all pins and paths currently on the map. Do you wish to continue?</p>
            <div class="modal-actions">
                <button class="btn btn-secondary" onclick="cancelLocationSwitch()">No</button>
                <button class="btn btn-danger" onclick="confirmLocationSwitch()">Yes, clear and switch</button>
            </div>
        </div>
    </div>

    <!-- Clear all confirmation modal -->
    <div class="modal-overlay" id="clear-confirm-modal">
        <div class="modal-content modal-sm">
            <h2>Clear All Paths?</h2>
            <p>This will remove every pin and path currently on the map. Do you wish to continue?</p>
            <div class="modal-actions">
                <button class="btn btn-secondary" onclick="cancelClearAll()">No</button>
                <button class="btn btn-danger" onclick="confirmClearAll()">Yes, clear all</button>
            </div>
        </div>
    </div>

    <!-- Path colour picker modal -->
    <div class="modal-overlay" id="color-picker-modal">
        <div class="modal-content modal-sm">
            <h2>Path Colour</h2>
            <p id="color-picker-path-name"></p>
            <div id="color-swatch-grid"></div>
            <div class="modal-actions">
                <button class="btn btn-secondary" onclick="closeColorPicker()">Cancel</button>
            </div>
        </div>
    </div>

    <!-- First-usage guided tour (populated dynamically by tour.js) -->
    <div id="tour-root"></div>

    <!-- Toasts -->
    <div id="error-toast" class="toast"></div>
    <div id="success-toast" class="toast"></div>

    <!-- JS modules (order matters: config first, then helpers, then features, then init last) -->
    <script src="~/js/config.js" asp-append-version="true"></script>
    <script src="~/js/ui.js" asp-append-version="true"></script>
    <script src="~/js/stats-table.js" asp-append-version="true"></script>
    <script src="~/js/elevation.js" asp-append-version="true"></script>
    <script src="~/js/path-manager.js" asp-append-version="true"></script>
    <script src="~/js/area-calc.js" asp-append-version="true"></script>
    <script src="~/js/pin-drag.js" asp-append-version="true"></script>
    <script src="~/js/csv-io.js" asp-append-version="true"></script>
    <script src="~/js/share.js" asp-append-version="true"></script>
    <script src="~/js/search.js" asp-append-version="true"></script>
    <script src="~/js/location.js" asp-append-version="true"></script>
    <script src="~/js/keyboard.js" asp-append-version="true"></script>
    <script src="~/js/tour.js" asp-append-version="true"></script>
    <script src="~/js/map-init.js" asp-append-version="true"></script>
</body>
</html>
