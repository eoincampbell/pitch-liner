@page
@model IndexModel
@{
    ViewData["Title"] = "Map Distance";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Map Distance</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="https://atlas.microsoft.com/sdk/javascript/mapcontrol/3/atlas.min.css" />
    <link rel="stylesheet" href="~/css/map-distance.css" asp-append-version="true" />
    <script src="https://atlas.microsoft.com/sdk/javascript/mapcontrol/3/atlas.min.js"></script>
</head>
<body>
    <div id="map"></div>

    <!-- Stats panel -->
    <div id="stats-panel">
        <div id="panel-content">
            <div id="stats-body"></div>
            <div id="area-info"></div>
            <div id="overall-total" class="overall-total" style="display:none;"></div>

            <hr class="panel-divider" />

            <!-- Drawing group -->
            <div class="btn-group">
                <span class="btn-group-label">Drawing</span>
                <div class="btn-row">
                    <button class="btn btn-dark" onclick="newPath()" title="Start a new path">&#x2795; Path</button>
                    <button class="btn btn-warning" onclick="undoLastPin()" title="Remove last pin">&#x21A9; Undo</button>
                    <button class="btn btn-secondary" onclick="closeShape()" title="Close shape and calculate area">&#x25B3; Close</button>
                </div>
            </div>

            <!-- Data group -->
            <div class="btn-group">
                <span class="btn-group-label">Data</span>
                <div class="btn-row">
                    <button class="btn btn-success" onclick="saveCsv()" title="Download CSV">&#x1F4BE; Save</button>
                    <button class="btn btn-primary" onclick="document.getElementById('load-input').click()" title="Load CSV file">&#x1F4C2; Load</button>
                    <button class="btn btn-purple" onclick="shareUrl()" title="Copy share URL to clipboard">&#x1F517; Share</button>
                    <input type="file" id="load-input" accept=".csv" style="display:none" onchange="loadCsv(event)" />
                </div>
            </div>

            <!-- Actions group -->
            <div class="btn-group">
                <div class="btn-row">
                    <button class="btn btn-danger btn-sm" onclick="clearAll()" title="Remove all paths and pins">Clear All</button>
                    <button class="btn btn-info btn-sm" onclick="showHelp()" title="Show help">? Help</button>
                </div>
            </div>

            <hr class="panel-divider" />

            <!-- Options -->
            <div class="panel-options-row">
                <label class="option-toggle" title="Show pin numbers on map">
                    <input type="checkbox" id="show-labels" onchange="toggleLabels()" />
                    <span class="toggle-slider"></span>
                    <span class="option-text">Pin Labels</span>
                </label>
                <label class="option-select" title="Distance unit">
                    <span class="option-text">Unit</span>
                    <select id="unit-select" onchange="changeUnit()">
                        <option value="m">m</option>
                        <option value="yd">yd</option>
                        <option value="km">km</option>
                        <option value="mi">mi</option>
                    </select>
                </label>
            </div>
        </div>
    </div>
    <!-- Slide toggle tab -->
    <button id="panel-toggle" class="panel-toggle" onclick="togglePanel()" title="Toggle stats panel">&#x25C0;</button>

    <!-- Branding -->
    <div id="branding">
        <img src="https://whitehallcolmcille.ie/wp-content/uploads/2019/06/logo.png" alt="Whitehall Colmcille GAA" />
        <span>Whitehall Colmcille GAA</span>
    </div>

    <!-- Search bar -->
    <div id="search-bar">
        <input type="text" id="search-input" placeholder="Search for an address..." autocomplete="off" />
        <div id="search-results"></div>
    </div>

    <!-- Map controls -->
    <div id="map-controls">
        <button class="map-ctrl-btn" onclick="mapZoom(1)" title="Zoom in">+</button>
        <button class="map-ctrl-btn" onclick="mapZoom(-1)" title="Zoom out">−</button>
        <button class="map-ctrl-btn" onclick="resetView()" title="Reset view">⌂</button>
        <button class="map-ctrl-btn" onclick="toggleStyle()" title="Toggle map style">🗺</button>
    </div>

    <!-- Elevation panel -->
    <div id="elevation-panel">
        <h4>Elevation Profile</h4>
        <canvas id="elevation-canvas" width="340" height="120"></canvas>
    </div>

    <!-- Help modal -->
    <div class="modal-overlay" id="help-modal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeHelp()">&times;</button>
            <h2>Pitch Liner – Map Distance Tool</h2>
            <h4>Placing Pins</h4>
            <ul>
                <li>Click anywhere on the map to drop a pin on the active path.</li>
                <li>Pins are connected by dotted lines; distances appear in the stats panel.</li>
            </ul>
            <h4>Multiple Paths</h4>
            <ul>
                <li><strong>&#x2795; Path</strong> – Create a new path with a unique colour.</li>
                <li>Click a path name in the panel to rename it.</li>
                <li>Use the <em>Set Active</em> button to switch between paths.</li>
            </ul>
            <h4>Drawing Controls</h4>
            <ul>
                <li><strong>&#x21A9; Undo</strong> – Remove the last pin on the active path.</li>
                <li><strong>&#x25B3; Close</strong> – Connect last pin to first, creating a closed shape with an area calculation (requires 3+ pins).</li>
            </ul>
            <h4>Data Controls</h4>
            <ul>
                <li><strong>&#x1F4BE; Save</strong> – Download all path data (including closed state) as a CSV file.</li>
                <li><strong>&#x1F4C2; Load</strong> – Upload a previously saved CSV to restore paths, closed shapes, and map position.</li>
                <li><strong>&#x1F517; Share</strong> – Copy a URL to the clipboard that encodes all paths, closed shapes, and the current map view (position, zoom, tilt, rotation).</li>
            </ul>
            <h4>Options</h4>
            <ul>
                <li><strong>Pin Labels</strong> – Toggle to show/hide numbered labels and running distances on the map.</li>
                <li><strong>Unit</strong> – Switch between metres (m), yards (yd), kilometres (km), and miles (mi). Affects all distances and areas.</li>
            </ul>
            <h4>Map Controls</h4>
            <ul>
                <li><strong>+</strong> / <strong>−</strong> – Zoom in or out.</li>
                <li><strong>⌂</strong> – Reset to default view.</li>
                <li><strong>🗺</strong> – Toggle between satellite and road map view.</li>
                <li>Right-click + drag to rotate and tilt the map (bearing &amp; pitch are saved in Share links).</li>
            </ul>
            <h4>Search</h4>
            <ul>
                <li>Type in the search bar to find addresses, landmarks, sports grounds, and points of interest.</li>
                <li>Click a result to centre the map on that location.</li>
            </ul>
            <h4>Keyboard &amp; Touch</h4>
            <ul>
                <li>Scroll wheel to zoom; pinch to zoom on touch devices.</li>
                <li>Two-finger rotate on touch; Ctrl + drag to rotate on desktop.</li>
            </ul>
        </div>
    </div>

    <!-- Toasts -->
    <div id="error-toast" class="toast"></div>
    <div id="success-toast" class="toast"></div>

    <!-- JS modules (order matters: config first, then helpers, then features, then init last) -->
    <script src="~/js/config.js" asp-append-version="true"></script>
    <script src="~/js/ui.js" asp-append-version="true"></script>
    <script src="~/js/stats-table.js" asp-append-version="true"></script>
    <script src="~/js/elevation.js" asp-append-version="true"></script>
    <script src="~/js/path-manager.js" asp-append-version="true"></script>
    <script src="~/js/area-calc.js" asp-append-version="true"></script>
    <script src="~/js/csv-io.js" asp-append-version="true"></script>
    <script src="~/js/share.js" asp-append-version="true"></script>
    <script src="~/js/search.js" asp-append-version="true"></script>
    <script src="~/js/map-init.js" asp-append-version="true"></script>
</body>
</html>
